{
  "name": "gam-mcp",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Read-only MCP server for Google Ad Manager analytics. Installable via npx.",
  "type": "module",
  "bin": {
    "gam-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standby/gam_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/standby/gam_mcp/issues"
  },
  "homepage": "https://github.com/standby/gam_mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "verify:pack": "tsx scripts/verify-pack.ts",
    "refresh-schema": "tsx scripts/refresh-schema.ts",
    "prepublishOnly": "npm run build && npm test && npm run verify:pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "google-auth-library": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
